<?php
/**
 * PayPal Express button for product page - Hyva/standalone (no RequireJS/Knockout).
 *
 * @var \Buckaroo\Magento2\Block\Catalog\Product\View\PaypalExpress $block
 * @var \Magento\Framework\Escaper $escaper
 */
?>
<?php if ($block->canShowProductButton() && !$block->isIdinVerificationRequired()): ?>
<?php
if (method_exists($block, 'getProductConfig')) {
    $config = $block->getProductConfig();
} else {
    $productPaypalExpressConfig = $block->getData('product_paypal_express_config');
    $config = $productPaypalExpressConfig
        ? $productPaypalExpressConfig->getConfig($block)
        : $block->getConfig();
}
$config['baseUrl'] = $block->getUrl('', ['_secure' => $block->getRequest()->isSecure()]);
?>
<div id="paypal-express-button-component-hyva" class="buckaroo-paypal-express-product">
    <div id="paypal-validation-error-hyva" class="paypal-validation-error" style="display: none;"></div>
    <div class="buckaroo-paypal-express" id="buckaroo-paypal-express-product"></div>
</div>
<script>
(function () {
    'use strict';

    var hyvaPaypal = window.BuckarooHyvaPaypalExpress;
    if (!hyvaPaypal) {
        return;
    }

    window.BuckarooHyvaCheckoutPaypalExpressConfig = <?= /* @noEscape */ json_encode($config) ?>;

    function run() {
        hyvaPaypal.positionProductPaypalButton();
        hyvaPaypal.whenReady(function () {
            return window.jQuery
                && window.BuckarooExpressProductPrice
                && window.BuckarooSdk
                && window.BuckarooSdk.PayPal;
        }, function () {
            if (typeof window.BuckarooHyvaCheckoutPaypalExpressInit === 'function') {
                window.BuckarooHyvaCheckoutPaypalExpressInit();
            }
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', run);
    } else {
        run();
    }
})();
</script>
<?php endif; ?>
