<?php

declare(strict_types=1);

use Buckaroo\HyvaCheckout\Magewire\Checkout\Idin;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var Idin $magewire */

// buckaroo-idin-required hides the payment methods until the shopper is verified (buckaroo-components.css)
?>
<div id="buckaroo-idin-verification"<?= $magewire->isRequired() ? ' class="buckaroo-idin-required"' : '' ?>>
    <?php if ($magewire->isRequired()): ?>
        <fieldset class="buckaroo-idin-verification mb-6 p-4 border border-gray-300 rounded-md">
            <legend class="flex items-center gap-x-2 px-1 font-semibold">
                <img src="<?= $escaper->escapeUrl($block->getViewFileUrl('Buckaroo_Magento2::images/idin.svg')) ?>"
                     alt=""
                     width="32"
                     height="32"
                     class="w-8 h-8"/>
                <?= $escaper->escapeHtml(__('Age verification')) ?>
            </legend>

            <p class="mb-4">
                <?= $escaper->escapeHtml(__('Verify your age with iDIN to continue with this order.')) ?>
                <?= $escaper->escapeHtml(__('The payment methods are shown after the verification.')) ?>
            </p>

            <div class="buckaroo-idin-verification__row">
                <div class="buckaroo-idin-verification__bank">
                    <label for="buckaroo_idin_issuer">
                        <?= $escaper->escapeHtml(__('Select your bank')) ?>
                        <span class="text-red-600">*</span>
                    </label>
                    <select id="buckaroo_idin_issuer"
                            name="buckaroo_idin_issuer"
                            class="form-select w-full"
                            wire:model.defer="issuer"
                            required>
                        <option value=""><?= $escaper->escapeHtml(__('Select a bank')) ?></option>
                        <?php foreach ($magewire->getIssuers() as $issuer): ?>
                            <option value="<?= $escaper->escapeHtmlAttr($issuer['code']) ?>">
                                <?= $escaper->escapeHtml($issuer['name']) ?>
                            </option>
                        <?php endforeach; ?>
                    </select>
                </div>

                <button type="button"
                        class="btn btn-primary buckaroo-idin-verification__button"
                        wire:click="verify"
                        wire:loading.attr="disabled">
                    <?= $escaper->escapeHtml(__('Verify your age via iDIN')) ?>
                </button>
            </div>
        </fieldset>
    <?php endif; ?>
</div>
