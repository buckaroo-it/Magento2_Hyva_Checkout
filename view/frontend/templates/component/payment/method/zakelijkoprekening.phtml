            id="buckaroo_zakelijkoprekening_fullname"
            class="bg-gray-200"
        >
    </div>

    <div class="flex flex-col gap-y-2 field field-reserved">
        <label for="buckaroo_zakelijkoprekening_coc">
            <?= $escaper->escapeHtml(__('COC Number:')) ?>
            <span class="text-red-600">*</span>
        </label>
