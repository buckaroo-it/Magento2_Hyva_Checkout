                 class="buckaroo-info-tooltip absolute bottom-full left-0 mb-2 z-50 bg-gray-800 text-white text-xs rounded px-3 py-2 shadow-lg">
                <?= $escaper->escapeHtml($tooltipText) ?>
                <?php if ($tooltipUrl !== '') : ?>
                    <a href="<?= $escaper->escapeUrl($tooltipUrl) ?>"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="underline text-blue-200"><?= $escaper->escapeHtml(__('lees meer.')) ?></a>
                <?php endif; ?>
            </div>
        </div>
    <?php endif; ?>

    <div class="flex flex-col gap-y-2 field field-reserved">
        <label for="buckaroo_zakelijkoprekening_fullname">
