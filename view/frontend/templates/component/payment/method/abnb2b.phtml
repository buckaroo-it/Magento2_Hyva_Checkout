use Magento\Framework\Escaper;

$tooltipText = $magewire->getTooltipText();
$tooltipLink = $magewire->getTooltipLink();
?>
<?php if ($tooltipText) : ?>
<div class="col-span-6 text-sm text-gray-600" x-data="{ open: false }">
    <div class="relative inline-flex items-center gap-1">
        <button type="button"
                class="text-gray-400 hover:text-gray-600"
                @mouseenter="open = true"
                @mouseleave="open = false"
                @click.prevent="open = !open"
                aria-label="<?= $escaper->escapeHtmlAttr(__('More information')) ?>">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path>
            </svg>
        </button>
        <div x-show="open"
             x-cloak
             class="absolute bottom-full left-0 mb-2 z-50 bg-gray-800 text-white text-xs rounded px-3 py-2 shadow-lg max-w-xs">
            <?php if ($tooltipLink) : ?>
                <?= $escaper->escapeHtml(trim(preg_replace('/lees meer\.?/i', '', $tooltipText))) ?>
                <a href="<?= $escaper->escapeUrl($tooltipLink) ?>"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="underline text-blue-200">
                    <?= $escaper->escapeHtml(__('lees meer')) ?>
