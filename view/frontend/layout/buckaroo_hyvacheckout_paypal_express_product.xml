<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <!-- Assets are added per enabled method by AddHyvaPaypalLayoutHandle (buckaroo_hyvacheckout_express_* handles). -->
    <body>
        <referenceBlock name="buckaroo_magento2.product.info.paypal.express"
                        template="Buckaroo_HyvaCheckout::catalog/product/view/paypal-express.phtml">
            <arguments>
                <argument name="product_paypal_express_config" xsi:type="object">Buckaroo\HyvaCheckout\ViewModel\ProductPaypalExpressConfig</argument>
            </arguments>
        </referenceBlock>
        <referenceBlock name="buckaroo_magento2.product.info.applepay"
                        template="Buckaroo_HyvaCheckout::express/applepay.phtml">
            <arguments>
                <argument name="apple_pay_express_config" xsi:type="object">Buckaroo\HyvaCheckout\ViewModel\ApplePayExpressConfig</argument>
                <argument name="express_page" xsi:type="string">Product</argument>
            </arguments>
        </referenceBlock>
        <referenceBlock name="buckaroo_magento2.product.info.ideal.fast.checkout"
                        template="Buckaroo_HyvaCheckout::express/ideal-fast-checkout.phtml">
            <arguments>
                <argument name="ideal_fast_checkout_config" xsi:type="object">Buckaroo\HyvaCheckout\ViewModel\IdealFastCheckoutConfig</argument>
                <argument name="express_page" xsi:type="string">Product</argument>
            </arguments>
        </referenceBlock>
    </body>
</page>
